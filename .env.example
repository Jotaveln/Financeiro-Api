# PostgreSQL / API
POSTGRES_DB=financeiro
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=change-this-local-password
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=financeiro;Username=financeiro;Password=change-this-local-password
Jwt__Key=replace-with-at-least-32-random-characters
Jwt__Issuer=Financeiro.Api
Jwt__Audience=Financeiro.Web
Auth__CookieSameSite=Lax
Cors__Origins__0=http://localhost:3000
Frontend__Url=http://localhost:3000
Database__ApplyMigrations=false
Seed__Enabled=false
Seed__DemoEmail=demo@financeiro.local
Seed__DemoPassword=ChangeThisDemo123!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_MODE=false
